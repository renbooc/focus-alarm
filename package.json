{
  "name": "@local/offwork-countdown",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "专注闹钟：DeepSeek Harness Web 的悬浮番茄钟，含下班倒计时、专注统计、节律提醒与系统通知。",
  "homepage": "https://github.com/renbooc/focus-alarm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbooc/focus-alarm.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pomodoro",
    "focus",
    "timer",
    "countdown",
    "番茄钟",
    "专注"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
